(* ============================================================================
   Layer 1: LEXICAL GRAMMAR (hand-authored; source of truth:
   src/compiler/internal/lex.cc and its reswords[] table). generate_ebnf.py
   includes this file verbatim when composing grammar.ebnf -- edit HERE, not
   the generated grammar.ebnf.
   ============================================================================ *)

letter = ? [A-Za-z] ? ;
digit = ? [0-9] ? ;
hexDigit = ? [0-9A-Fa-f] ? ;
binDigit = "0" | "1" ;

identifier = ( letter | "_" ), { letter | digit | "_" } ;

(* Underscores are legal digit separators in integer and real forms. *)
decimalNumber = digit, { digit | "_" } ;
hexNumber = "0", ( "x" | "X" ), hexDigit, { hexDigit | "_" } ;
binaryNumber = "0", ( "b" | "B" ), binDigit, { binDigit | "_" } ;
integerLiteral = hexNumber | binaryNumber | decimalNumber ;
realLiteral = decimalNumber, ".", { digit | "_" }, [ exponent ]
            | decimalNumber, exponent ;
exponent = ( "e" | "E" ), [ "+" | "-" ], digit, { digit | "_" } ;

escapeSequence = "\\", ( "n" | "t" | "r" | "b" | "a" | "e" | '"' | "'" | "\\" )
               | "\\", "x", { hexDigit }
               | "\\", ? octal digits ?
               | "\\", ? any other character ? ;

stringLiteral = '"', { ? any character except '"' ? | escapeSequence }, '"' ;
characterLiteral = "'", ( ? any single byte ? | escapeSequence ), "'" ;

(* Text blocks are consumed by get_text_block()/get_array_block(). The
   terminator follows @ or @@ and must appear at the beginning of a later
   line. A single @ produces one string; @@ produces an array literal. *)
textBlock = "@", identifier, ? newline ?, ? raw lines ?, identifier ;
textArrayBlock = "@@", identifier, ? newline ?, ? raw lines ?, identifier ;

(* In ordinary source a '//' comment ends at the physical newline. The
   directive scanner handles backslash-newline splicing before it recognizes
   comments and block-comment boundaries. *)
lineComment = "//", { ? any character except newline ? } ;
blockComment = "/*", { ? any character sequence not containing "*/" ? }, "*/" ;

keywordControl = "acatch" | "array" | "await" | "break" | "case" | "catch"
               | "continue" | "default" | "do" | "efun" | "else" | "for"
               | "foreach" | "if" | "in" | "inherit" | "new"
               | "parse_command" | "ref" | "return" | "sscanf" | "switch"
               | "time_expression" | "while" | "__TREE__" ;
keywordType = "buffer" | "float" | "function" | "int" | "mapping" | "mixed"
            | "object" | "promise" | "string" | "void" ;
keywordModifier = "async" | "nomask" | "nosave" | "private" | "protected"
                | "public" | "static" | "varargs" ;
classKeyword = "class" | "struct" ;

functionalOpen = "(:" ;
functionalClose = ":)" ;
functionalParameter = "$", decimalNumber ;

(* ============================================================================
   Layer 2: PREPROCESSOR GRAMMAR (hand-authored; source of truth:
   lex.cc's directive capture and conditional-expression scanner).
   Preprocessing is interleaved with lexing in ONE scan -- directives take
   effect at exactly their position in the token stream.

   C translation phases 2-4 in one scan: a backslash immediately followed by
   a newline is deleted first (splice); comments then become one space; then
   the '#' line is parsed. A block comment may close on a later physical line.
   A '//' comment runs to the logical newline, so a trailing '\\' continues it.
   The directive ends at the next newline that was not spliced and is not
   inside a block comment.
   ============================================================================ *)

directiveLine = ? line start ?, [ ? whitespace ? ], "#", directive ;
directive = defineDirective | undefDirective | includeDirective
          | conditionalDirective | pragmaDirective | lineDirective
          | echoDirective | errorDirective | warnDirective ;

defineDirective = "define", identifier, [ macroParameters ], { ? replacement token ? } ;
macroParameters = "(", [ identifier, { ",", identifier } ], ")" ;
(* Inside a replacement list: "#param" stringizes and "a ## b" pastes. *)

undefDirective = "undef", identifier ;
includeDirective = "include", ( '"', ? file path ?, '"'
                              | "<", ? file path ?, ">"
                              | ? macro expanding to either form ? ) ;

conditionalDirective = "if", constantExpression
                     | "ifdef", identifier
                     | "ifndef", identifier
                     | "elif", constantExpression
                     | "else"
                     | "endif" ;
constantExpression = ? integer-valued token expression ? ;

pragmaDirective = "pragma", identifier, { ",", identifier } ;
lineDirective = "line", decimalNumber, [ '"', ? file path ?, '"' ] ;
echoDirective = "echo", { ? any token ? } ;
errorDirective = "error", { ? any token ? } ;
warnDirective = "warn", { ? any token ? } ;

builtinMacro = "__LINE__" | "__FILE__" | "__DIR__" ;

(* ============================================================================
   Layer 3: SYNTAX GRAMMAR (generated from grammar.y via bison --xml).
   Do not edit -- regenerate with the generate_ebnf CMake target.
   ============================================================================ *)

all = program ;

program = { def, possibleSemiColon } ;

possibleSemiColon = ""
                    | ";" ;

inheritance = typeModifierList, LInherit, stringCon1, ";" ;

real = LReal ;

number = LNumber ;

optionalStar = ""
               | "*" ;

blockOrSemi = block
              | ";"
              | error ;

identifier = LDefinedName
             | LIdentifier ;

function = type, optionalStar, identifier, "(", argument, ")", blockOrSemi ;

def = function
      | type, nameList, ";"
      | inheritance
      | typeDecl
      | modifierChange ;

modifierChange = typeModifierList, ":" ;

memberName = optionalStar, identifier ;

memberNameList = memberName, { ",", memberName } ;

memberList = { basicType, memberNameList, ";" } ;

typeDecl = typeModifierList, LClass, identifier, "{", memberList, "}" ;

newLocalName = LIdentifier
               | LDefinedName ;

atomicType = LBasicType
             | LPromise
             | LPromise, "<", basicType, optionalStar, LOrder
             | LClass, LDefinedName
             | LClass, LIdentifier ;

optAtomicType = atomicType
                | "" ;

basicType = atomicType
            | optAtomicType, LArray ;

argType = basicType
          | basicType, ref ;

optionalDefaultArgValue = ""
                          | ":", LFunctionOpen, commaExpr, ":", ")" ;

newArg = argType, optionalStar
         | argType, optionalStar, newLocalName, optionalDefaultArgValue
         | newLocalName ;

argument = ""
           | argumentList
           | argumentList, LDotDotDot ;

argumentList = newArg, { ",", newArg } ;

typeModifierList = { LTypeModifier } ;

type = typeModifierList, optBasicType ;

cast = "(", basicType, optionalStar, ")" ;

optBasicType = basicType
               | "" ;

nameList = newName, { ",", newName } ;

newName = optionalStar, identifier
          | optionalStar, identifier, LAssign, expr0 ;

block = "{", blockStatements, "}" ;

declBlock = block
            | for
            | foreach ;

localDeclarations = { basicType, localNameList, ";" } ;

newLocalDef = optionalStar, newLocalName
              | optionalStar, newLocalName, LAssign, expr0 ;

singleNewLocalDef = argType, optionalStar, newLocalName ;

singleNewLocalDefWithInit = singleNewLocalDef, LAssign, expr0 ;

localNameList = newLocalDef, { ",", newLocalDef } ;

localDeclarationStatement = basicType, localNameList, ";" ;

blockStatements = { statement | localDeclarationStatement | error, ";" } ;

statement = commaExpr, ";"
            | cond
            | while
            | do
            | switch
            | return
            | declBlock
            | ";"
            | LBreak, ";"
            | LContinue, ";" ;

while = LWhile, "(", commaExpr, ")", statement ;

do = LDo, statement, LWhile, "(", commaExpr, ")", ";" ;

for = LFor, "(", firstForExpr, ";", forExpr, ";", forExpr, ")", statement ;

foreachVar = LDefinedName
             | singleNewLocalDef
             | LIdentifier ;

foreachVars = foreachVar
              | foreachVar, ",", foreachVar ;

foreach = LForeach, "(", foreachVars, LIn, expr0, ")", statement ;

forExpr = ""
          | commaExpr ;

firstForExpr = forExpr
               | singleNewLocalDefWithInit ;

switch = LSwitch, "(", commaExpr, ")", "{", localDeclarations, case, switchBlock, "}" ;

switchBlock = { case | statement } ;

case = LCase, caseLabel, ":"
       | LCase, caseLabel, LRange, caseLabel, ":"
       | LCase, caseLabel, LRange, ":"
       | LCase, LRange, caseLabel, ":"
       | LDefault, ":" ;

caseLabel = constant
            | stringCon1 ;

constant = constant, "|", constant
           | constant, "^", constant
           | constant, "&", constant
           | constant, LEq, constant
           | constant, LNe, constant
           | constant, LOrder, constant
           | constant, "<", constant
           | constant, LLsh, constant
           | constant, LRsh, constant
           | constant, "+", constant
           | constant, "-", constant
           | constant, "*", constant
           | constant, "%", constant
           | constant, "/", constant
           | "(", constant, ")"
           | LNumber
           | "-", LNumber
           | LNot, LNumber
           | "~", LNumber ;

commaExpr = expr0, { ",", expr0 } ;

ref = LRef ;

expr0 = ref, lvalue
        | lvalue, LAssign, expr0
        | error, LAssign, expr0
        | expr0, "?", expr0, ":", expr0
        | expr0, LQuestionQuestion, expr0
        | expr0, LLor, expr0
        | expr0, LLand, expr0
        | expr0, "|", expr0
        | expr0, "^", expr0
        | expr0, "&", expr0
        | expr0, LEq, expr0
        | expr0, LNe, expr0
        | expr0, LOrder, expr0
        | expr0, "<", expr0
        | expr0, LLsh, expr0
        | expr0, LRsh, expr0
        | expr0, "+", expr0
        | expr0, "-", expr0
        | expr0, "*", expr0
        | expr0, "%", expr0
        | expr0, "/", expr0
        | cast, expr0
        | LInc, lvalue
        | LDec, lvalue
        | LAwait, expr0
        | LNot, expr0
        | "~", expr0
        | "-", expr0
        | lvalue, LInc
        | lvalue, LDec
        | expr4
        | sscanf
        | parseCommand
        | timeExpression
        | number
        | real ;

return = LReturn, ";"
         | LReturn, commaExpr, ";" ;

exprList = ""
           | exprList2
           | exprList2, "," ;

exprListNode = expr0
               | expr0, LDotDotDot ;

exprList2 = exprListNode, { ",", exprListNode } ;

exprList3 = ""
            | exprList4
            | exprList4, "," ;

exprList4 = assocPair, { ",", assocPair } ;

assocPair = expr0, ":", expr0 ;

lvalue = expr4 ;

lNewFunctionOpen = LNewFunctionOpen
                   | LFunctionOpen, efunOverride ;

expr4 = functionCall
        | LDefinedName
        | LIdentifier
        | LParameter
        | "$", "(", commaExpr, ")"
        | expr4, LArrow, identifier
        | expr4, LDot, identifier
        | expr4, "[", commaExpr, LRange, commaExpr, "]"
        | expr4, "[", "<", commaExpr, LRange, commaExpr, "]"
        | expr4, "[", "<", commaExpr, LRange, "<", commaExpr, "]"
        | expr4, "[", commaExpr, LRange, "<", commaExpr, "]"
        | expr4, "[", commaExpr, LRange, "]"
        | expr4, "[", "<", commaExpr, LRange, "]"
        | expr4, "[", "<", commaExpr, "]"
        | expr4, "[", commaExpr, "]"
        | string
        | "(", commaExpr, ")"
        | catch
        | acatch
        | tree
        | LBasicType, "(", argument, ")", block
        | lNewFunctionOpen, ":", ")"
        | lNewFunctionOpen, ",", exprList2, ":", ")"
        | LFunctionOpen, commaExpr, ":", ")"
        | LMappingOpen, exprList3, "]", ")"
        | LArrayOpen, exprList, "}", ")" ;

exprOrBlock = block
              | "(", commaExpr, ")" ;

catch = LCatch, exprOrBlock ;

acatch = LAcatch, exprOrBlock ;

tree = LTree, block
       | LTree, "(", commaExpr, ")" ;

sscanf = LSscanf, "(", expr0, ",", expr0, lvalueList, ")" ;

parseCommand = LParseCommand, "(", expr0, ",", expr0, ",", expr0, lvalueList, ")" ;

timeExpression = LTimeExpression, exprOrBlock ;

lvalueList = { ",", lvalue } ;

string = stringCon2 ;

stringCon1 = stringCon2
             | "(", stringCon1, ")"
             | stringCon1, "+", stringCon1 ;

stringCon2 = LString, { LString } ;

classInit = identifier, ":", expr0 ;

optClassInit = { ",", classInit } ;

functionCall = efunOverride, "(", exprList, ")"
               | LNew, "(", exprList, ")"
               | LNew, "(", LClass, LDefinedName, optClassInit, ")"
               | LNew, "(", LClass, LIdentifier, optClassInit, ")"
               | LDefinedName, "(", exprList, ")"
               | functionName, "(", exprList, ")"
               | expr4, "[", commaExpr, "]", "(", exprList, ")"
               | expr4, LArrow, identifier, "(", exprList, ")"
               | "(", "*", commaExpr, ")", "(", exprList, ")" ;

efunOverride = LEfun, LColonColon, identifier
               | LEfun, LColonColon, LNew ;

functionName = LIdentifier
               | LColonColon, identifier
               | LBasicType, LColonColon, identifier
               | identifier, LColonColon, identifier ;

cond = LIf, "(", commaExpr, ")", statement, optionalElsePart ;

optionalElsePart = ""
                   | LElse, statement ;

private int value = 73;
private mixed nested;

#ifdef __PACKAGE_CONTRIB__
int count_lines(string path) {
  return file_length(path);
}
#endif

#ifdef __PACKAGE_EXTERNAL__
void external_read(int fd, string data) {}
void external_write(int fd) {}
void external_close(int fd) {}

int launch_external() {
  return external_start(3, ({}), "external_read", "external_write", "external_close");
}
#endif

int move_file(string source, string destination) {
  return rename(source, destination);
}

int save_state(string path, int flags) {
  return save_object(path, flags);
}

int restore_state(string path) {
  return restore_object(path);
}

void reset_state() {
  value = 73;
  nested = 0;
}

void deep_state() {
  for (int i = 0; i < 200; i++) {
    nested = ({ nested });
  }
}

int query_value() {
  return value;
}

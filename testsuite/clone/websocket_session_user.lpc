void read_command(string command);

private int close_on_gmcp;

void write_prompt() {}

void gmcp_enable() {
  if (close_on_gmcp) {
    tell_object(this_object(), "CALLBACK\n");
    destruct(this_object());
  }
}

void logon() {
  tell_object(this_object(), "READY " + query_ip_number(this_object()) + "\n");
  input_to("read_command");
}

void resume_after_exec() {
  tell_object(this_object(), "EXEC\n");
  input_to("read_command");
}

void receive_message(string message_class, string value) {
  if (message_class == "u11") {
    tell_object(this_object(), value);
  }
}

void u11_get_char(string value) {
  tell_object(this_object(), "U11_GET_CHAR:" + value + "\n");
  input_to("read_command");
}

void stop_driver() {
  "/single/u09_websocket_master"->finish_tests();
}

void net_dead() {
  "/single/u09_websocket_master"->record_net_dead();
  destruct(this_object());
}

void read_command(string command) {
  switch (command) {
    case "callback-destruct":
      close_on_gmcp = 1;
      tell_object(this_object(), "ARMED\n");
      break;
    case "stats":
      tell_object(this_object(), sprintf("STATS %d %d\n", sizeof(users()),
                  "/single/u09_websocket_master"->query_net_dead()));
      break;
    case "u11-output": {
      mixed notify_value;
      printf("U11_PRINTF:%s:%d\n", "ok", 7);
      message("u11", "U11_MESSAGE\n", this_object());
      notify_fail("U11_NOTIFY");
      notify_value = query_notify_fail();
      if (!stringp(notify_value)) {
        error("query_notify_fail did not return the configured string");
      }
      tell_object(this_object(), "U11_NOTIFY:" + notify_value + "\n");
      break;
    }
    case "u11-get-char":
      tell_object(this_object(), "U11_GET_CHAR_READY\n");
      if (!get_char("u11_get_char")) {
        error("get_char did not accept the interactive session");
      }
      return;
    case "u11-telnet":
      telnet_nop();
      telnet_ga();
      telnet_msp_oob("!!SOUND(cow.wav L=2 V=100)");
      tell_object(this_object(), "U11_TELNET_DONE\n");
      break;
    case "exec": {
      object next = new("/clone/websocket_session_user");
      tell_object(this_object(), "BEFORE\n");
      if (!exec(next, this_object())) {
        error("websocket session exec failed");
      }
      next->resume_after_exec();
      destruct(this_object());
      return;
    }
    case "disconnect":
      tell_object(this_object(), "CLOSED\n");
      destruct(this_object());
      return;
    case "burst":
    case "close":
      tell_object(this_object(), "B" + implode(allocate(8193, "ab中🙂"), "") + "Z\n");
      if (command == "close") {
        destruct(this_object());
        return;
      }
      break;
    case "shutdown":
      tell_object(this_object(), "BYE\n");
      call_out_walltime("stop_driver", 0.05);
      return;
    default:
      tell_object(this_object(), "ECHO " + command + "\n");
      break;
  }
  input_to("read_command");
}

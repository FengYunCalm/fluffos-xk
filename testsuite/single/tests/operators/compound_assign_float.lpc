// Compound assignment (+= -= *= /=) with a float RHS on an int-holding
// lvalue: whether the lvalue promotes to float or truncates and stays int
// depends on whether its type is statically known.
float global_f;

float dynamic_float() {
  return 1.5;
}

void do_tests() {
  float f;
  int i;

  ASSERT_EQ(1, floatp(f));
  ASSERT_EQ(1, floatp(global_f));

  f += 1;
  ASSERT_EQ(1, floatp(f));
  ASSERT_EQ(1.0, f);

  global_f += 1;
  ASSERT_EQ(1, floatp(global_f));
  ASSERT_EQ(1.0, global_f);

  f = 0;
  f -= 1;
  ASSERT_EQ(1, floatp(f));
  ASSERT_EQ(-1.0, f);

  f = 2;
  f *= 0.5;
  ASSERT_EQ(1, floatp(f));
  ASSERT_EQ(1.0, f);

  f = 1;
  f /= 2;
  ASSERT_EQ(1, floatp(f));
  ASSERT_EQ(0.5, f);

  f = 1.5;
  f += 1;
  ASSERT_EQ(1, floatp(f));
  ASSERT_EQ(2.5, f);

  i = 10;
  i += 1.5;
  ASSERT_EQ(1, intp(i));
  ASSERT_EQ(11, i);

  i = 10;
  i -= 1.5;
  ASSERT_EQ(1, intp(i));
  ASSERT_EQ(9, i);

  i = 3;
  i *= 1.5;
  ASSERT_EQ(1, intp(i));
  ASSERT_EQ(3, i);

  i = 7;
  i /= 2.0;
  ASSERT_EQ(1, intp(i));
  ASSERT_EQ(3, i);

  // Dynamic calls are statically mixed even when the callee is float.
  i = 10;
  i += this_object()->dynamic_float();
  ASSERT_EQ(1, intp(i));
  ASSERT_EQ(11, i);

  i = 10;
  function fp = (: dynamic_float :);
  i += evaluate(fp);
  ASSERT_EQ(1, intp(i));
  ASSERT_EQ(11, i);

  mixed m = 1;
  m += 0.5;
  ASSERT_EQ(1, floatp(m));
  ASSERT_EQ(1.5, m);

  m = 10;
  m -= 0.5;
  ASSERT_EQ(1, floatp(m));
  ASSERT_EQ(9.5, m);

  m = 3;
  m *= 1.5;
  ASSERT_EQ(1, floatp(m));
  ASSERT_EQ(4.5, m);

  m = 7;
  m /= 2.0;
  ASSERT_EQ(1, floatp(m));
  ASSERT_EQ(3.5, m);

  mapping map = ([ "count": 5 ]);
  map["count"] += 1.5;
  ASSERT_EQ(1, floatp(map["count"]));
  ASSERT_EQ(6.5, map["count"]);

  map["fresh"] += 1.5;
  ASSERT_EQ(1, floatp(map["fresh"]));
  ASSERT_EQ(1.5, map["fresh"]);

  int *arr = ({ 5 });
  arr[0] += 1.5;
  ASSERT_EQ(1, intp(arr[0]));
  ASSERT_EQ(6, arr[0]);

  mixed *marr = ({ 5 });
  marr[0] += 1.5;
  ASSERT_EQ(1, floatp(marr[0]));
  ASSERT_EQ(6.5, marr[0]);
}

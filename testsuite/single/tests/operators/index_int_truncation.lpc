// An LPC int is 64-bit, but the index/range paths used to copy it into an
// int32_t before range-checking it. A value past 32 bits therefore wrapped
// back into range and silently picked or overwrote a real element:
// a[1<<32] = 9 hit a[0], and a[1<<32] read a[0].
//
// The bounds are now computed and checked in LPC_INT (and the string helpers
// clamp to +-(len+1) before narrowing), so an out-of-range index either errors
// or reports absent. This test asserts the invariant that matters -- a
// past-32-bit index never addresses a real element -- without pinning which of
// the two a given read path picks.
//
// The bound is stored in a variable on purpose: a constant bound written
// directly in the range (e.g. `a[0 .. 1 << 32]`) is folded into an immediate
// operand that the compiler front end still truncates -- a separate defect
// tracked in docs/roadmap.md (R-10).

// Value of an out-of-range read: either the path errors, or it reports absent
// with 0 / "". A real element or subrange always fails this.
private int absent(mixed had_error, mixed value) {
  if (had_error) return 1;
  if (value == 0 || value == "") return 1;
  if (arrayp(value) && sizeof(value) == 0) return 1;
  return 0;
}

void do_tests() {
  mixed *a = ({ 1, 2, 3 });
  string s = "abc";
  buffer b = allocate_buffer(3);
  int big = 1 << 32;
  int big1 = big + 1;
  mixed e;
  mixed v;

  // Element stores must not wrap into element 0.
  ASSERT(catch(a[big] = 9));
  ASSERT_EQ(1, a[0]);
  ASSERT_EQ(3, sizeof(a));

  ASSERT(catch(b[big] = 7));
  ASSERT_EQ(0, b[0]);

  // Compound stores take the same path.
  ASSERT(catch(a[big] += 1));
  ASSERT_EQ(1, a[0]);

  // rvalue index: absent, never element 0.
  e = 0;
  v = 0;
  e = catch(v = s[big1]);
  ASSERT(absent(e, v));
  e = 0;
  v = 0;
  e = catch(v = b[big1]);
  ASSERT(absent(e, v));
  e = 0;
  v = 0;
  e = catch(v = a[big1]);
  ASSERT(absent(e, v));

  // rvalue ranges: absent, never a real subrange.
  e = 0;
  v = 0;
  e = catch(v = ({ 1, 2, 3 })[big1 ..]);
  ASSERT(absent(e, v));
  e = 0;
  v = 0;
  e = catch(v = ({ 1, 2, 3 })[big1 .. 2]);
  ASSERT(absent(e, v));
  e = 0;
  v = 0;
  e = catch(v = "abc"[big1 ..]);
  ASSERT(absent(e, v));

  // A range lvalue with a past-32-bit bound must not truncate the bound and
  // delete a real prefix.
  ASSERT(catch(a[0 .. big] = ({})));
  ASSERT_EQ(({ 1, 2, 3 }), a);

  // In-range behaviour is untouched.
  a[1] = 20;
  ASSERT_EQ(({ 1, 20, 3 }), a);
  ASSERT_EQ("b", s[1 .. 1]);
  ASSERT_EQ(({ 2, 3 }), ({ 1, 2, 3 })[1 ..]);
  ASSERT_EQ(({ 1, 2 }), ({ 1, 2, 3 })[0 .. 1]);
}

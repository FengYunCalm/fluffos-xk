#ifdef __PACKAGE_COMPRESS__
private int same_bytes(buffer expected, buffer actual) {
  if (sizeof(expected) != sizeof(actual)) {
    return 0;
  }
  for (int i = 0; i < sizeof(expected); i++) {
    if (expected[i] != actual[i]) {
      return 0;
    }
  }
  return 1;
}

void do_tests() {
  string source = "/compress_integrity_input";
  string compressed = source + ".gz";
  ASSERT2(file_size(source) == -1, "initial source exists");
  ASSERT2(file_size(compressed) == -1, "initial compressed exists");

  foreach (int size in ({ 0, 1, 4095, 4096, 4097, 8193 })) {
    buffer payload = allocate_buffer(size);
    for (int i = 0; i < size; i += 127) {
      payload[i] = 255;
    }
    ASSERT2(write_file(source, "", 1) == 1,
      sprintf("size=%d empty write", size));
    if (size) {
      ASSERT2(write_buffer(source, 0, payload) == 1,
        sprintf("size=%d buffer write", size));
    }
    ASSERT2(write_file(compressed, "previous destination", 1) == 1,
      sprintf("size=%d destination write", size));
    ASSERT2(compress_file(source) == 1,
      sprintf("size=%d compress", size));
    ASSERT2(file_size(source) == -1,
      sprintf("size=%d source remains", size));
    ASSERT2(uncompress_file(compressed) == 1,
      sprintf("size=%d uncompress", size));
    ASSERT2(file_size(compressed) == -1,
      sprintf("size=%d compressed remains", size));
    ASSERT2(file_size(source) == size,
      sprintf("size=%d source size", size));
    if (size) {
      ASSERT2(same_bytes(payload, read_buffer(source)),
        sprintf("size=%d payload", size));
    }
    ASSERT2(rm(source) == 1, sprintf("size=%d remove source", size));
  }

  // zlib's existing transparent-read contract also accepts non-gzip input.
  ASSERT2(write_file(source, "plain input", 1) == 1, "transparent write");
  ASSERT2(uncompress_file(source, compressed) == 1,
    "transparent uncompress");
  ASSERT2(read_file(compressed) == "plain input", "transparent payload");
  ASSERT2(rm(compressed) == 1, "transparent remove");

  foreach (int truncated in ({ 0, 1 })) {
    buffer damaged;
    ASSERT2(write_file(source, "gzip payload", 3) == 1,
      sprintf("corrupt=%d gzip write", truncated));
    damaged = read_buffer(source);
    ASSERT2(sizeof(damaged) > 8,
      sprintf("corrupt=%d gzip size", truncated));
    if (truncated) {
      // Retain the gzip header and truncate the compressed stream itself.
      damaged = damaged[0 ..<sizeof(damaged) - 1];
    } else {
      int crc_offset = sizeof(damaged) - 8;
      damaged[crc_offset] = damaged[crc_offset] ^ 64;
    }
    ASSERT2(write_file(source, "", 1) == 1,
      sprintf("corrupt=%d reset source", truncated));
    ASSERT2(write_buffer(source, 0, damaged) == 1,
      sprintf("corrupt=%d damaged write", truncated));
    ASSERT2(uncompress_file(source, compressed) == 0,
      sprintf("corrupt=%d uncompress", truncated));
    ASSERT2(same_bytes(damaged, read_buffer(source)),
      sprintf("corrupt=%d source payload", truncated));
    ASSERT2(rm(source) == 1,
      sprintf("corrupt=%d remove source", truncated));
    ASSERT2(rm(compressed) == 1,
      sprintf("corrupt=%d remove compressed", truncated));
  }
}
#endif

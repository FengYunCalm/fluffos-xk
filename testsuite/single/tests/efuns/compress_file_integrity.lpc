#ifdef __PACKAGE_COMPRESS__
private int same_bytes(buffer expected, buffer actual) {
  if (sizeof(expected) != sizeof(actual)) {
    return 0;
  }
  for (int i = 0; i < sizeof(expected); i++) {
    if (expected[i] != actual[i]) {
      return 0;
    }
  }
  return 1;
}

private int diagnostic_step;

private void check_condition(int condition) {
  diagnostic_step++;
  if (!condition)
    shutdown(40 + diagnostic_step);
}

void do_tests() {
  string source = "/compress_integrity_input";
  string compressed = source + ".gz";
  check_condition(file_size(source) == -1);
  check_condition(file_size(compressed) == -1);

  foreach (int size in ({ 0, 1, 4095, 4096, 4097, 8193 })) {
    buffer payload = allocate_buffer(size);
    for (int i = 0; i < size; i += 127) {
      payload[i] = 255;
    }
    check_condition(write_file(source, "", 1) == 1);
    if (size) {
      check_condition(write_buffer(source, 0, payload) == 1);
    }
    check_condition(write_file(compressed, "previous destination", 1) == 1);
    check_condition(compress_file(source) == 1);
    check_condition(file_size(source) == -1);
    check_condition(uncompress_file(compressed) == 1);
    check_condition(file_size(compressed) == -1);
    check_condition(file_size(source) == size);
    if (size) {
      check_condition(same_bytes(payload, read_buffer(source)));
    }
    check_condition(rm(source) == 1);
  }

  check_condition(write_file(source, "plain input", 1) == 1);
  check_condition(uncompress_file(source, compressed) == 1);
  check_condition(read_file(compressed) == "plain input");
  check_condition(rm(compressed) == 1);

  foreach (int truncated in ({ 0, 1 })) {
    buffer damaged;
    check_condition(write_file(source, "gzip payload", 3) == 1);
    damaged = read_buffer(source);
    check_condition(sizeof(damaged) > 8);
    if (truncated) {
      damaged = damaged[0 ..<sizeof(damaged) - 1];
    } else {
      int crc_offset = sizeof(damaged) - 8;
      damaged[crc_offset] = damaged[crc_offset] ^ 64;
    }
    check_condition(write_file(source, "", 1) == 1);
    check_condition(write_buffer(source, 0, damaged) == 1);
    check_condition(uncompress_file(source, compressed) == 0);
    check_condition(same_bytes(damaged, read_buffer(source)));
    check_condition(rm(source) == 1);
    check_condition(rm(compressed) == 1);
  }
}
#endif

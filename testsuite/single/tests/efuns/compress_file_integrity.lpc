#ifdef __PACKAGE_COMPRESS__
private int same_bytes(buffer expected, buffer actual) {
  if (sizeof(expected) != sizeof(actual)) {
    return 0;
  }
  for (int i = 0; i < sizeof(expected); i++) {
    if (expected[i] != actual[i]) {
      return 0;
    }
  }
  return 1;
}

void do_tests() {
  string source = "/compress_integrity_input";
  string compressed = source + ".gz";
  ASSERT_EQ(-1, file_size(source));
  ASSERT_EQ(-1, file_size(compressed));

  foreach (int size in ({ 0, 1, 4095, 4096, 4097, 8193 })) {
    buffer payload = allocate_buffer(size);
    for (int i = 0; i < size; i += 127) {
      payload[i] = 255;
    }
    ASSERT_EQ(1, write_file(source, "", 1));
    if (size) {
      ASSERT_EQ(1, write_buffer(source, 0, payload));
    }
    ASSERT_EQ(1, write_file(compressed, "previous destination", 1));
    ASSERT_EQ(1, compress_file(source));
    ASSERT_EQ(-1, file_size(source));
    ASSERT_EQ(1, uncompress_file(compressed));
    ASSERT_EQ(-1, file_size(compressed));
    ASSERT_EQ(size, file_size(source));
    if (size) {
      ASSERT(same_bytes(payload, read_buffer(source)));
    }
    ASSERT_EQ(1, rm(source));
  }

  // zlib's existing transparent-read contract also accepts non-gzip input.
  ASSERT_EQ(1, write_file(source, "plain input", 1));
  ASSERT_EQ(1, uncompress_file(source, compressed));
  ASSERT_EQ("plain input", read_file(compressed));
  ASSERT_EQ(1, rm(compressed));
}
#endif

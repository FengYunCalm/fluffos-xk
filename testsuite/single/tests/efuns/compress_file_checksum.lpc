#ifdef __PACKAGE_COMPRESS__
private int same_bytes(buffer expected, buffer actual) {
  if (sizeof(expected) != sizeof(actual)) {
    return 0;
  }
  for (int i = 0; i < sizeof(expected); i++) {
    if (expected[i] != actual[i]) {
      return 0;
    }
  }
  return 1;
}

void do_tests() {
  string source = "/compress_checksum_input";
  string compressed = source + ".gz";
  ASSERT_EQ(1, write_file(source, "gzip payload", 3));
  buffer damaged = read_buffer(source);
  ASSERT(sizeof(damaged) > 8);
  int crc_offset = sizeof(damaged) - 8;
  damaged[crc_offset] = damaged[crc_offset] ^ 64;
  ASSERT_EQ(1, write_file(source, "", 1));
  ASSERT_EQ(1, write_buffer(source, 0, damaged));
  ASSERT_EQ(0, uncompress_file(source, compressed));
  ASSERT(same_bytes(damaged, read_buffer(source)));
  ASSERT_EQ(1, rm(source));
  ASSERT_EQ(1, rm(compressed));
}
#endif

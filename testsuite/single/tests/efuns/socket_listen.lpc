#ifdef __PACKAGE_SOCKETS__
#define STREAM 1
#define EESUCCESS 1

void read_callback(int fd) {}
void listen_callback(int fd) {}

void do_tests() {
  int fd = socket_create(STREAM, "read_callback");
  socket_bind(fd, 0);
  ASSERT_EQ(EESUCCESS, socket_listen(fd, "listen_callback"));
  socket_close(fd);

  fd = socket_create(STREAM, "read_callback");
  ASSERT(socket_listen(fd, "listen_callback") < 0);
  socket_close(fd);
}
#endif

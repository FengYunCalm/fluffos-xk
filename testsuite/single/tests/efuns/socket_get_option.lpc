#ifdef __PACKAGE_SOCKETS__

// Public ABI numbers are fixed independently of the driver's C++ enum.
#define STREAM 1
#define SO_TLS_VERIFY_PEER 1
#define SO_TLS_SNI_HOSTNAME 2
#define SO_TLS_CERT 3
#define SO_TLS_KEY 4

private int first = -1;
private int second = -1;

void unused_callback(int fd) {
  ASSERT2(0, "Unconnected socket must not invoke callbacks");
}

private void cleanup() {
  if (first >= 0) {
    socket_close(first);
    first = -1;
  }
  if (second >= 0) {
    socket_close(second);
    second = -1;
  }
}

private void exercise() {
  int before = 7143;
  string after = "unchanged";
  mixed *locals = ({before, after});
  int closed;
  string held;

  first = socket_create(STREAM, "unused_callback", "unused_callback");
  second = socket_create(STREAM, "unused_callback", "unused_callback");
  ASSERT(first >= 0);
  ASSERT(second >= 0);
  ASSERT(first != second);

  foreach (int fd in ({first, second})) {
    ASSERT_EQ(socket_get_option(fd, SO_TLS_VERIFY_PEER), 0);
    ASSERT(!undefinedp(socket_get_option(fd, SO_TLS_VERIFY_PEER)));
    foreach (int option in ({SO_TLS_SNI_HOSTNAME, SO_TLS_CERT, SO_TLS_KEY})) {
      ASSERT_EQ(socket_get_option(fd, option), 0);
      ASSERT(!undefinedp(socket_get_option(fd, option)));
    }
  }
  foreach (int value in ({0, 1, 0, 1})) {
    socket_set_option(first, SO_TLS_VERIFY_PEER, value);
    socket_set_option(second, SO_TLS_VERIFY_PEER, 1 - value);
    ASSERT_EQ(socket_get_option(first, SO_TLS_VERIFY_PEER), value);
    ASSERT_EQ(socket_get_option(second, SO_TLS_VERIFY_PEER), 1 - value);
  }
  foreach (int option in ({SO_TLS_SNI_HOSTNAME, SO_TLS_CERT, SO_TLS_KEY})) {
    string value = sprintf("option-%d.example", option);
    socket_set_option(first, option, value);
    socket_set_option(second, option, "other");
    held = socket_get_option(first, option);
    ASSERT_EQ(held, value);
    ASSERT_EQ(socket_get_option(second, option), "other");
    socket_set_option(first, option, "replacement");
    ASSERT_EQ(held, value);
    socket_set_option(first, option, "");
    ASSERT_EQ(socket_get_option(first, option), "");
  }

  ASSERT(catch(socket_get_option(-1, SO_TLS_VERIFY_PEER)));
  ASSERT(catch(socket_get_option(2147483647, SO_TLS_VERIFY_PEER)));
  ASSERT(catch(socket_get_option(first, 0)));
  ASSERT(catch(socket_get_option(first, 5)));
  ASSERT(catch(socket_set_option(first, SO_TLS_VERIFY_PEER, 2)));
  ASSERT(catch(socket_set_option(first, SO_TLS_SNI_HOSTNAME, 3)));
  ASSERT_EQ(before, 7143);
  ASSERT_EQ(after, "unchanged");
  ASSERT_EQ(locals, ({7143, "unchanged"}));

  socket_set_option(first, SO_TLS_SNI_HOSTNAME, "retained.example");
  held = socket_get_option(first, SO_TLS_SNI_HOSTNAME);
  closed = first;
  ASSERT_EQ(socket_close(first), 1);
  first = -1;
  ASSERT_EQ(held, "retained.example");
  foreach (int option in ({1, 2, 3, 4})) {
    ASSERT_EQ(socket_get_option(closed, option), 0);
    ASSERT(!undefinedp(socket_get_option(closed, option)));
  }
  first = socket_create(STREAM, "unused_callback", "unused_callback");
  ASSERT(first >= 0);
  ASSERT_EQ(socket_get_option(first, SO_TLS_VERIFY_PEER), 0);
  ASSERT_EQ(socket_get_option(first, SO_TLS_SNI_HOSTNAME), 0);
}

void do_tests() {
  mixed failure = catch(exercise());
  cleanup();
  if (failure) {
    error(failure);
  }
}

#endif

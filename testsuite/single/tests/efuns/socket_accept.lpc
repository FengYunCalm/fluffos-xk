#ifdef __PACKAGE_SOCKETS__
#define STREAM 1

void read_callback(int fd) {}

void do_tests() {
  int fd = socket_create(STREAM, "read_callback");
  socket_bind(fd, 0);
  socket_listen(fd, "read_callback");
  ASSERT(socket_accept(fd, "read_callback", "read_callback") < 0);
  socket_close(fd);
}
#endif

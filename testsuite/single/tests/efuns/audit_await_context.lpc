private int completion_token;
private mixed gate;

async int legal_for_loop() {
  int total = 0;
  for (int i = 0; i < 2; i++) {
    total += await gate;
  }
  return total;
}

async int legal_acatch() {
  acatch(await 2);
  return 1;
}

void finish(int result) {
  ASSERT_EQ(6, result);
  promise_then(legal_acatch(), function(int acatch_result) {
    ASSERT_EQ(1, acatch_result);
    "/command/tests"->complete_async(completion_token);
  });
}

void do_tests() {
  completion_token = "/command/tests"->begin_async();
  gate = promise_create();
  promise_then(legal_for_loop(), (: finish($1) :));
  call_out(function() {
    promise_resolve(gate, 3);
  }, 1);
}

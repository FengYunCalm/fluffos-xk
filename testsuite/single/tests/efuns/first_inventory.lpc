void create(object destination) {
  if (destination) {
    move_object(destination);
  }
}

void do_tests() {
  object box = new(__FILE__);
  ASSERT_EQ(0, first_inventory(box));
  object a = new(__FILE__, box);
  object b = new(__FILE__, box);
  // Most recent move is first.
  ASSERT_EQ(b, first_inventory(box));
  destruct(a);
  destruct(b);
  destruct(box);
}

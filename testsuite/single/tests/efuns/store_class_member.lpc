class P { int x; string s; }

void do_tests() {
  class P p = new(class P, x: 5, s: "hi");
  store_class_member(p, 0, 8);
  ASSERT_EQ(8, p->x);
  store_class_member(p, 1, "bye");
  ASSERT_EQ("bye", p->s);
  ASSERT(catch(store_class_member(p, 9, 1)));
  // A member index past 32 bits must be out of bounds, not wrap back to 0/1.
  ASSERT(catch(store_class_member(p, (1 << 32) + 1, 1)));
  ASSERT(catch(store_class_member(p, 1 << 32, 1)));
  ASSERT_EQ(8, p->x);
  ASSERT_EQ("bye", p->s);
}

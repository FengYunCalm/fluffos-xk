#ifdef __PACKAGE_SOCKETS__
#define STREAM 1
#define EESUCCESS 1

void read_callback(int fd) {}
void close_callback(int fd) {}

void do_tests() {
  int fd = socket_create(STREAM, "read_callback", "close_callback");
  ASSERT(fd >= 0);
  ASSERT_EQ(EESUCCESS, socket_close(fd));
  ASSERT(socket_create(-1, "read_callback") < 0);
}
#endif

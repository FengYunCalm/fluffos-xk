#ifdef __PACKAGE_SOCKETS__
#define STREAM 1

private int acquire_result = -1;

void read_callback(int fd) {}
void write_callback(int fd) {}
void close_callback(int fd) {}

void acquire_callback(int fd, object owner) {
  acquire_result = socket_acquire(fd, "read_callback", "write_callback", "close_callback");
}

void do_tests() {
  int fd = socket_create(STREAM, "read_callback", "close_callback");
  ASSERT(fd >= 0);
  ASSERT_EQ(1, socket_release(fd, this_object(), (: acquire_callback :)));
  ASSERT_EQ(1, acquire_result);
  ASSERT_EQ(1, socket_close(fd));
}
#endif

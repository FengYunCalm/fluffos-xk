private int completion_token;
private int done;
private int yield_count;
private int event_turn;

async mixed yield_probe() {
  mixed result;

  for (int i = 0; i < 3; i++) {
    result = await async_yield();
    ASSERT_EQ(0, result);
    ASSERT_EQ(1, event_turn);
  }

  yield_count = event_turn;
  return yield_count;
}

void do_tests() {
  completion_token = "/command/tests"->begin_async();
  done = 0;
  event_turn = 0;
  yield_count = 0;
  call_out(function() { event_turn = 1; }, 0);

  promise_then(yield_probe(), function(mixed result) {
    ASSERT_EQ(1, result);
    ASSERT_EQ(1, yield_count);
    done = 1;
  });

  call_out(function() {
    ASSERT_EQ(1, done);
    ASSERT_EQ(1, yield_count);
    "/command/tests"->complete_async(completion_token);
  }, 2);
}

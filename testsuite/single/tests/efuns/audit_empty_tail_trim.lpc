int action() {
  return 1;
}

void do_tests() {
#ifndef __NO_ADD_ACTION__
  object save_tp = this_player();

  enable_commands();
  add_action((: action :), "foo");
  disable_commands();
  if (save_tp) {
    evaluate(bind((: enable_commands :), save_tp));
  }

  ASSERT_EQ(0, command(""));
  ASSERT_EQ(0, command("   "));
  ASSERT(command("foo"));
  destruct(this_object());
#endif
}
